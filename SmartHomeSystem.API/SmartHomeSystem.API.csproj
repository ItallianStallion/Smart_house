<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- XML-коментарі контролерів для Swagger; CS1591 (немає коментаря) приглушено -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <!-- Сховище секретів розробника (dotnet user-secrets): значення лежать поза репозиторієм -->
    <UserSecretsId>smarthome-api-lab5</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.9.2" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="8.0.11" />
    <!-- Потрібен лише для команд dotnet ef (міграції); у збірку для запуску не потрапляє -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartHomeSystem.Services\SmartHomeSystem.Services.csproj" />
    <ProjectReference Include="..\SmartHomeSystem.Infrastructure\SmartHomeSystem.Infrastructure.csproj" />
  </ItemGroup>

</Project>
